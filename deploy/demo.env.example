# Copy to .env.demo (ignored by Git); pass --env-file .env.demo to Compose.
PM_DEMO_DOMAIN=demo.example.com
PM_FRONTEND_HOSTS=demo.example.com
# Replace with a random deployment-only secret BEFORE bootstrap; never use the local default.
PM_JWT_SECRET=
# Paste the pre-minted bootstrap token here BEFORE starting api/caddy.
PM_DEMO_TOKEN=
# Dedicated score-free capture identity; never put the nurse token in this slot.
PM_DEMO_PSW_TOKEN=
# Separate synthetic safety-tenant self-custody identity, populated privately by start-demo.
PM_DEMO_KAZE_TOKEN=
PM_DEMO_KAZE_PATIENT_ID=
PM_PROVIDER=stub
PM_RATE_LIMIT=600
PM_WHISPER_MODEL=base
# BL-14 loader presentation for the `load` step: all-history or scenario-snapshots.
PM_DEMO_PRESENTATION=all-history
PM_KEEP_AUDIO=false

# Fixed synthetic runner capture profile; keep independent from KAZE safety policy.
PM_NO_ESCALATE_PATIENTS=21926d8c-0847-53df-a9b1-96fbcf21e43c

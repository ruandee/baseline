PM_ENVIRONMENT=synthetic
PM_DATABASE_URL=postgresql://pm_runtime:synthetic-runtime@127.0.0.1:55432/patient_memory?connect_timeout=5
PM_ADMIN_DATABASE_URL=postgresql://postgres:synthetic-admin@127.0.0.1:55432/patient_memory?connect_timeout=5
PM_OBJECT_ENDPOINT=http://localhost:59000
PM_PROVIDER=stub
PM_WHISPER_MODEL=base
PM_TOKEN_TTL_HOURS=48
PM_RATE_LIMIT=600

# Optional Gemini-compatible context/SBAR provider. Never commit the key.
# PM_PROVIDER=compatible
# PM_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai
# PM_PROVIDER_MODEL=gemini-3.8-flash
# PM_PROVIDER_KEY=
PM_KEEP_AUDIO=false

# Hosted frontend (decision 005): only when serving the demo behind a TLS proxy.
# PM_FRONTEND_HOSTS=demo.example.com
# PM_DEMO_TOKEN=<48-hour synthetic nurse token minted by scripts/demo_reset.py>
# PM_DEMO_PSW_TOKEN=<optional synthetic PSW token for /check resident mode; never receives scores>
# Change engine thresholds (defaults shown)
# PM_Z_THRESHOLD=2.0
# PM_PROVISIONAL_Z=3.0
# PM_MIN_FEATURES=2
# PM_EWMA_LAMBDA=0.3
# PM_CUSUM_K=0.5
# PM_CUSUM_H=4.0

# KAZE SMS defaults to redacted logging; no real delivery unless explicitly configured.
PM_SMS_PROVIDER=log
PM_ACK_BASE_URL=http://127.0.0.1:8000
# PM_SMS_PROVIDER=twilio
# PM_TWILIO_SID=<account SID>
# PM_TWILIO_TOKEN=<auth token; never commit>
# PM_TWILIO_FROM=<E.164 sender or MG... Messaging Service SID>
# PM_SMS_ALLOWED_RECIPIENTS=<approved E.164 numbers, comma-separated>
# PM_ACK_BASE_URL=https://demo.example.com
# PM_ACK_TTL_MIN=360

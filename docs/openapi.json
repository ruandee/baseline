  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "patient_id": {
            "type": "string",
            "format": "uuid",
            "title": "Patient Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "partial",
              "insufficient_evidence",
              "conflicting_evidence"
            ],
            "title": "Status"
          },
          "as_of": {
            "type": "string",
            "format": "date-time",
            "title": "As Of"
          },
          "known_at": {
            "type": "string",
            "format": "date-time",
            "title": "Known At"
          },
          "memory_revision": {
            "type": "integer",
            "title": "Memory Revision"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "unknowns": {
            "items": {
              "$ref": "#/components/schemas/Unknown"
            },
            "type": "array",
            "title": "Unknowns"
          },
          "conflicts": {
            "items": {
              "$ref": "#/components/schemas/Conflict"
            },
            "type": "array",
            "title": "Conflicts"
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Versions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "patient_id",
          "status",
          "as_of",
          "known_at",
          "memory_revision",
          "claims",
          "evidence",
          "unknowns",
          "conflicts",
          "coverage",
          "versions"
        ],
        "title": "Answer"
      },
      "AssignmentInput": {
        "properties": {
          "principal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Principal Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "importer",
              "nurse",
              "patient"
            ],
            "title": "Role"
          },
          "active": {
            "type": "boolean",
            "title": "Active",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "principal_id",
          "role"
        ],
        "title": "AssignmentInput"
      },
      "Claim": {
        "properties": {
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "epistemic_status": {
            "type": "string",
            "enum": [
              "documented",
              "patient_reported",
              "historical",
              "uncertain"
            ],
            "title": "Epistemic Status"
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "effective_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim_id",
          "section",
          "text",
          "epistemic_status",
          "evidence_ids",
          "effective_at"
        ],
        "title": "Claim"
      },
      "Conflict": {
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "claim_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Claim Ids"
          },
          "evidence_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "resolution": {
            "type": "null",
            "title": "Resolution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "topic",
          "claim_ids",
          "evidence_ids"
        ],
        "title": "Conflict"
      },
      "Coverage": {
        "properties": {
          "index_complete": {
            "type": "boolean",
            "title": "Index Complete"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated"
          },
          "degraded_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Degraded Mode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index_complete",
          "truncated"
        ],
        "title": "Coverage"
      },
      "Evidence": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evidence Id"
          },
          "source_version_id": {
